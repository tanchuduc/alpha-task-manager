# Supabase (bắt buộc)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase Service Role Key (chỉ dùng phía Server để Admin tạo tài khoản nhân sự nội bộ)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Domain email nội bộ được phép đăng nhập Google OAuth (để trống nếu cho phép tất cả email đã tạo)
NEXT_PUBLIC_ALLOWED_EMAIL_DOMAIN=alphabooks.vn

# URL ứng dụng (dùng để tạo link công việc trong thông báo Telegram / Lark)
NEXT_PUBLIC_APP_URL=http://localhost:3000
